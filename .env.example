# URL pública/base usada para gerar links de rastreamento de entregadores.
# Usada no QR Code do romaneio e no link compartilhado por WhatsApp.
# Quando ausente, cai em window.location.origin (que é "http://localhost:5173"
# em dev — o QR não funciona em outros dispositivos).
#
# Em DEV (testar QR no celular):
#   VITE_DELIVERY_TRACKING_BASE_URL=http://192.168.x.x:5173
#
# Em PRODUÇÃO:
#   VITE_DELIVERY_TRACKING_BASE_URL=https://app.seudominio.com.br
VITE_DELIVERY_TRACKING_BASE_URL=
